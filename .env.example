# Public (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser Web Push public key (URL-safe base64 from `npx @pushforge/builder vapid`).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only. Never prefix with NEXT_PUBLIC.
# Required later for Edge Functions, admin tasks, and scheduled jobs.
# Do not put this in Vercel or Next.js. Hosted Edge Functions inject it.
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function only. Leave MISTRAL_API_KEY unset to enforce manual fallback with zero spend.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-2512
OPEN_FOOD_FACTS_USER_AGENT=Frist/0.1 (contact: you@example.com)

# Edge Function secrets only (Dashboard → Edge Functions → Secrets, or `npx supabase secrets set`).
# VAPID_PRIVATE_KEY is the JWK JSON from `npx @pushforge/builder vapid`.
# CRON_SECRET authenticates pg_cron → push-dispatch. Generate with a long random string.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
